{# templates/login/detail.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card bg-dark-teal text-light-gray p-4" style="max-width: 400px; width: 100%;">
            <h1 class="text-center mb-4">Login</h1>

            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form action="{{ path('app_login') }}" method="post" class="login-form">
                <div class="mb-3">
                    <label for="username" class="form-label">Email:</label>
                    <input type="text" id="username" name="_username" value="{{ last_username }}" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password:</label>
                    <input type="password" id="password" name="_password" class="form-control" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn-deep-orange w-100">Login</button>
            </form>

            <div class="text-center mt-3">
                <p class="mb-0">Don't have an account? <a href="{{ path('app_register') }}" class="text-light-cyan">Sign up</a></p>
            </div>
        </div>
    </div>
{% endblock %}