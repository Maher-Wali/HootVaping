{# templates/registration/register.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card bg-dark-teal text-light-gray p-4" style="max-width: 400px; width: 100%;">
            <h1 class="text-center mb-4">Register</h1>

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm, {'attr': {'class': 'login-form'}}) }}
            <div class="mb-3">
                {{ form_row(registrationForm.firstname, {
                    'attr': {'class': 'form-control'},
                    'label_attr': {'class': 'form-label'}
                }) }}
            </div>

            <div class="mb-3">
                {{ form_row(registrationForm.lastname, {
                    'attr': {'class': 'form-control'},
                    'label_attr': {'class': 'form-label'}
                }) }}
            </div>

            <div class="mb-3">
                {{ form_row(registrationForm.email, {
                    'attr': {'class': 'form-control'},
                    'label_attr': {'class': 'form-label'}
                }) }}
            </div>

            <div class="mb-3">
                {{ form_row(registrationForm.plainPassword, {
                    'label': 'Password',
                    'attr': {'class': 'form-control'},
                    'label_attr': {'class': 'form-label'}
                }) }}
            </div>

            <button type="submit" class="btn btn-deep-orange w-100">Register</button>
            {{ form_end(registrationForm) }}

            <div class="text-center mt-3">
                <p class="mb-0">Already have an account? <a href="{{ path('app_login') }}" class="text-light-cyan">Login</a></p>
            </div>
        </div>
    </div>
{% endblock %}
