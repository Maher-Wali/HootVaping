{% extends 'base.html.twig' %}

{% block title %}Complete Your Profile{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h2>Complete Your Profile</h2>
        <p>Please complete your profile to proceed with your order.</p>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        <div class="row">
            <div class="col-md-6">
                <h4>Personal Information</h4>
                <div class="mb-3">
                    {{ form_label(form.firstname) }}
                    {{ form_widget(form.firstname, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
                    {{ form_errors(form.firstname) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.lastname) }}
                    {{ form_widget(form.lastname, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
                    {{ form_errors(form.lastname) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.phone_number) }}
                    {{ form_widget(form.phone_number, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
                    {{ form_errors(form.phone_number) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.password) }}
                    {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
                    <small class="text-muted">Leave blank to keep your current password.</small>
                    {{ form_errors(form.password) }}
                </div>
            </div>

            <div class="col-md-6">
                <h4>Shipping Address</h4>
                <div class="mb-3">
                    {{ form_label(form.address.state) }}
                    {{ form_widget(form.address.state, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
                    {{ form_errors(form.address.state) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.address.city) }}
                    {{ form_widget(form.address.city, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
                    {{ form_errors(form.address.city) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.address.street) }}
                    {{ form_widget(form.address.street, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
                    {{ form_errors(form.address.street) }}
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Save & Continue</button>

        {{ form_end(form) }}
    </div>
{% endblock %}
