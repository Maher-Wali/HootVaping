{% extends 'base.html.twig' %}

{% block title %}Your Cart{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('add-to-cart').addEventListener('click', function () {
                window.location.href = '/package';
            });
        });
    </script>
{% endblock %}

{% block stylesheets %}
    <style>
        /* Centering and enlarging the text */
        .empty-cart-message {
            text-align: center;
            font-size: 36px;
            font-weight: bold;
            margin-top: 50px;
            color: #FCF2D6;
        }

        /* Add to Cart Button */
        .button-container {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

        .button {
            height: 60px;
            width: 200px;
            background-color: #FCF2D6; /* Keeping your original Light Cyan color */
            border: 2px solid #FCF2D6; /* Deep Orange */
            color: #1E1E1E; /* Charcoal Black */
            transition: width 0.6s, background-color 0.6s;
            font-size: 15px;
            font-weight: bold;
            border-radius: 50px;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }

        .button span {
            transition: transform 0.5s, font-size 0.3s;
        }

        .button svg {
            opacity: 0;
            position: absolute;
            transform: translateX(100px); /* Start hidden */
            transition: transform 0.6s;
            z-index: 3;
            height: 20px;
        }

        .button:hover {
            width: 60px; /* Reduce to a circle */
            background-color: #FF5700; /* Deep Orange */
            color: #E0E0E0;
        }

        .button:hover span {
            transform: translateY(70px); /* Hide text */
            font-size: 0;
        }

        .button:hover svg {
            opacity: 1;
            transform: translateX(0); /* Move icon to the center */
        }
    </style>
{% endblock %}

{% block body %}
    <h2 class="empty-cart-message">Your Cart is Empty</h2>
    <div class="button-container">
        <button id="add-to-cart" type="button" class="button">
            <span>Start Shopping</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l3.6 7.59M9 19a2 2 0 100 4 2 2 0 000-4zm9 0a2 2 0 100 4 2 2 0 000-4zM5 5h14l-1.6 8.21a2 2 0 01-2 1.79H9.6a2 2 0 01-2-1.79L5 5z"/>
            </svg>
        </button>
    </div>
{% endblock %}
