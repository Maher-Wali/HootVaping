                                    <div class="product-name">Fruits Tropical</div>
                                    <div class="product-meta">E-liquide premium</div>
                                </div>
                            </div>
                            <div class="quantity-badge">
                                <i class="fas fa-times"></i> 2
                            </div>
                        </div>
                        
                        <div class="product-item">
                            <div class="product-info-item">
                                <div class="product-icon">
                                    <i class="fas fa-snowflake"></i>
                                </div>
                                <div class="product-details">
                                    <div class="product-name">Menthe Glaciale</div>
                                    <div class="product-meta">E-liquide premium</div>
                                </div>
                            </div>
                            <div class="quantity-badge">
                                <i class="fas fa-times"></i> 2
                            </div>
                        </div>
                        
                        <div class="product-item">
                            <div class="product-info-item">
                                <div class="product-icon">
                                    <i class="fas fa-seedling"></i>
                                </div>
                                <div class="product-details">
                                    <div class="product-name">Vanille Bourbon</div>
                                    <div class="product-meta">E-liquide premium</div>
                                </div>
                            </div>
                            <div class="quantity-badge">
                                <i class="fas fa-times"></i> 2
