<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Eliquide Tunisie | Liquide Vape – HootVaping{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="HootVaping est votre boutique en ligne spécialisée dans les eliquides, cigarettes électroniques et accessoires vape en Tunisie. Livraison rapide garantie.">

    <meta property="og:title" content="Vape Tunisie | Eliquide fruité – HootVaping" />
    <meta property="og:description" content="Commandez votre eliquide en Tunisie sur HootVaping. Livraison rapide, produits de qualité." />
    <meta property="og:image" content="{{ asset('uploads/logo.png') }}" />
    <meta property="og:url" content="{{ app.request.uri }}" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />

    <link rel="canonical" href="{{ app.request.scheme ~ '://' ~ app.request.host ~ app.request.pathInfo }}" />
    <link rel="icon" type="image/png" href="{{ asset('uploads/logo.ico') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    {% block stylesheets %}
        <style>
            html, body {
                background: url("{{ asset('uploads/background.jpg') }}") nrepeat center center fixed;
                background-size: cover;
                background-color : transparent;
                color: #E0E0E0; /* Light Gray Text */
                font-family: Arial, sans-serif;
                margin: 0;
                padding: 0;
                height: 100%;
            }
        </style>
    {% endblock %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    {% block javascripts %}
        <script>
            $(document).ready(function() {
                // Debug logging
                console.log('DOM Ready');

                // Cache jQuery selections
                const $searchInput = $('#search-input');
                const $searchResults = $('#search-results');
                const $searchForm = $('#search-form');

                // Debug elements
                console.log('Search input found:', $searchInput.length > 0);
                console.log('Search results found:', $searchResults.length > 0);
                console.log('Search form found:', $searchForm.length > 0);

                // Handle input changes
                $searchInput.on('input', function() {
                    const query = $(this).val() || '';
                    console.log('Input value:', query);

                    if (query.length >= 1) {
                        performSearch(query);
                    } else {
                        $searchResults.empty().hide();
                    }
                });

                // Handle form submission
                $searchForm.on('submit', function(e) {
                    e.preventDefault();
                    const query = $searchInput.val() || '';
                    console.log('Form submitted with query:', query);

                    if (query.length >= 1) {
                        performSearch(query);
                    }
                });

                // Function to perform the search
                function performSearch(query) {
                    if (!query) {
                        console.warn('Empty query, skipping search');
                        return;
                    }

                    console.log('Performing search for:', query);

                    $.ajax({
                        url: '{{ path('app_search') }}',
                        type: 'GET',
                        data: { q: query },
                        success: function(response) {
                            console.log('Search response received');
                            $searchResults.html(response).show();
                        },
                        error: function(xhr, status, error) {
                            console.error('Search error:', error);
                            console.error('Status:', status);
                            console.error('Response:', xhr.responseText);
                        }
                    });
                }

                // Hide results when clicking outside
                $(document).on('click', function(e) {
                    if (!$(e.target).closest('.search-form').length) {
                        $searchResults.hide();
                    }
                });

                // Show results when focusing on input
                $searchInput.on('focus', function() {
                    const currentResults = $searchResults.html().trim();
                    if (currentResults.length > 0) {
                        $searchResults.show();
                    }
                });

                // Mobile menu functionality
                $('.hamburger-menu').on('click', function() {
                    openNav();
                });

                $('.sidenav .closebtn').on('click', function() {
                    closeNav();
                });

                $('.overlay').on('click', function() {
                    closeNav();
                });

                // Dropdown functionality in sidenav
                $('.dropdown-toggle-mobile').on('click', function(e) {
                    e.preventDefault();
                    $(this).next('.sidenav-dropdown').slideToggle();
                });

                function openNav() {
                    $('#mySidenav').css('width', '250px');
                    $('.overlay').fadeIn();
                    $('body').css('overflow', 'hidden'); // Prevent body scrolling
                }

                function closeNav() {
                    $('#mySidenav').css('width', '0');
                    $('.overlay').fadeOut();
                    $('body').css('overflow', ''); // Restore body scrolling
                }

                // Promo code functionality for sidenav
                $('#submit-gift-sidenav').on('click', function() {
                    const giftCode = $('#gift-code-input-sidenav').val().trim();
                    console.log('Submitting code from sidenav:', giftCode);
                    if (giftCode) {
                        // Show loading state
                        $(this).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>');
                        $(this).prop('disabled', true);

                        // Call your updated PromoCodeController
                        $.ajax({
                            url: '{{ path("app_promo_code_apply") }}',
                            type: 'GET',
                            data: { code: giftCode },
                            dataType: 'json',
                            success: function(response) {
                                console.log('Success response:', response);
                                // Reset button state
                                $('#submit-gift-sidenav').html('Apply');
                                $('#submit-gift-sidenav').prop('disabled', false);

                                if (response.success) {
                                    // Show success message
                                    showToast('success', response.message || 'Promo code applied successfully!');
                                    $('#gift-code-input-sidenav').val('');
                                    closeNav(); // Close the menu after success

                                    if (window.location.pathname === '/cart') {
                                        window.location.reload();
                                    }
                                } else {
                                    // Show error message
                                    showToast('error', response.message);

                                    // If login is required, redirect
                                    if (response.redirectUrl) {
                                        setTimeout(function() {
                                            window.location.href = response.redirectUrl;
                                        }, 2000); // Redirect after 2 seconds
                                    }
                                }
                            },
                            error: function(xhr, status, error) {
                                console.error('Error applying promo code:', error);
                                // Reset button state
                                $('#submit-gift-sidenav').html('Apply');
                                $('#submit-gift-sidenav').prop('disabled', false);
                                showToast('error', 'An error occurred while applying the promo code.');
                            }
                        });
                    }

                    function showToast(type, message) {
                        // Create toast container if it doesn't exist
                        if ($('#toast-container').length === 0) {
                            $('body').append('<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 5000;"></div>');
                        }

                        // Generate a unique ID for this toast
                        const toastId = 'toast-' + Date.now();

                        // Define toast color based on type
                        let bgColor = 'bg-primary';
                        if (type === 'success') bgColor = 'bg-success';
                        if (type === 'error') bgColor = 'bg-danger';
                        if (type === 'warning') bgColor = 'bg-warning';

                        // Create the toast
                        const toast = `
    <div id="${toastId}" class="toast ${bgColor} text-white" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000">
        <div class="toast-header">
            <strong class="me-auto">${type.charAt(0).toUpperCase() + type.slice(1)}</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            ${message}
        </div>
    </div>
    `;

                        // Add the toast to the container
                        $('#toast-container').append(toast);

                        // Initialize and show the toast using Bootstrap's API
                        const toastElement = new bootstrap.Toast(document.getElementById(toastId));
                        toastElement.show();

                        // Remove toast after it's hidden
                        $(`#${toastId}`).on('hidden.bs.toast', function() {
                            $(this).remove();
                        });
                    }
                });


            });

            $(document).ready(function() {
                const $giftButton = $('#gift-button');
                const $giftInput = $('.gift-input-wrapper');
                const $giftCodeInput = $('#gift-code-input');

                // Toggle gift input on button click
                $giftButton.on('click', function(e) {
                    e.preventDefault();
                    $giftInput.slideToggle(200);
                    if ($giftInput.is(':visible')) {
                        $giftCodeInput.focus();
                    }
                });

                // Hide gift input when clicking outside
                $(document).on('click', function(e) {
                    if (!$(e.target).closest('.gift-input-container').length) {
                        $giftInput.slideUp(200);
                    }
                });

                // Prevent hiding when clicking inside the input
                $giftInput.on('click', function(e) {
                    e.stopPropagation();
                });

                // Handle gift code submission
                // Handle gift code submission
                $('#submit-gift').on('click', function() {
                    const giftCode = $giftCodeInput.val().trim();
                    console.log('Submitting code:', giftCode); // Debug log
                    if (giftCode) {
                        // Show loading state
                        $(this).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Applying...');
                        $(this).prop('disabled', true);

                        // Call your updated PromoCodeController
                        $.ajax({
                            url: '{{ path("app_promo_code_apply") }}',
                            type: 'GET',
                            data: { code: giftCode },
                            dataType: 'json',
                            success: function(response) {
                                console.log('Success response:', response); // Debug log
                                // Reset button state
                                $('#submit-gift').html('Apply');
                                $('#submit-gift').prop('disabled', false);

                                if (response.success) {
                                    // Show success message
                                    showToast('success', response.message || 'Promo code applied successfully!');

                                    // Close the popup
                                    $giftInput.slideUp(200);
                                    $giftCodeInput.val('');

                                    // If you want to update the cart display with the new discount
                                    // you could trigger a cart refresh here or redirect to cart
                                    if (window.location.pathname === '/cart') {
                                        // If we're on the cart page, refresh it
                                        window.location.reload();
                                    } else {
                                        // Optionally redirect to cart
                                        // window.location.href = '/cart';
                                    }
                                } else {
                                    // Show error message
                                    showToast('error', response.message);

                                    // If login is required, redirect
                                    if (response.redirectUrl) {
                                        setTimeout(function() {
                                            window.location.href = response.redirectUrl;
                                        }, 2000); // Redirect after 2 seconds
                                    }
                                }
                            },
                            error: function(xhr, status, error) {
                                console.error('Error applying promo code:', error);
                                // Reset button state
                                $('#submit-gift').html('Apply');
                                $('#submit-gift').prop('disabled', false);
                                showToast('error', 'An error occurred while applying the promo code.');
                            }
                        });
                    }
                });



// Helper function to show toast notifications
                function showToast(type, message) {
                    // Create toast container if it doesn't exist
                    if ($('#toast-container').length === 0) {
                        $('body').append('<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 5000;"></div>');
                    }

                    // Generate a unique ID for this toast
                    const toastId = 'toast-' + Date.now();

                    // Define toast color based on type
                    let bgColor = 'bg-primary';
                    if (type === 'success') bgColor = 'bg-success';
                    if (type === 'error') bgColor = 'bg-danger';
                    if (type === 'warning') bgColor = 'bg-warning';

                    // Create the toast
                    const toast = `
    <div id="${toastId}" class="toast ${bgColor} text-white" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000">
        <div class="toast-header">
            <strong class="me-auto">${type.charAt(0).toUpperCase() + type.slice(1)}</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            ${message}
        </div>
    </div>
    `;

                    // Add the toast to the container
                    $('#toast-container').append(toast);

                    // Initialize and show the toast using Bootstrap's API
                    const toastElement = new bootstrap.Toast(document.getElementById(toastId));
                    toastElement.show();

                    // Remove toast after it's hidden
                    $(`#${toastId}`).on('hidden.bs.toast', function() {
                        $(this).remove();
                    });
                }
            });

            $(document).ready(function() {
                // Mobile search toggle functionality
                $('#mobile-search-toggle').on('click', function(e) {
                    e.preventDefault();
                    $('header').addClass('search-active');
                    $('#search-input').focus();
                });

                // Close mobile search
                $('#mobile-search-close').on('click', function(e) {
                    e.preventDefault();
                    $('header').removeClass('search-active');
                });

                // Hide search when clicking outside
                $(document).on('click', function(e) {
                    if ($('header').hasClass('search-active') &&
                        !$(e.target).closest('.search-form').length &&
                        !$(e.target).closest('#mobile-search-toggle').length) {
                        $('header').removeClass('search-active');
                    }
                });

                // Prevent search form from closing when clicking inside it
                $('.search-form').on('click', function(e) {
                    e.stopPropagation();
                });
            });
        </script>
    {% endblock %}
</head>
<body class="{% block body_class %}d-flex flex-column min-vh-100{% endblock %}"> <!-- Makes body take at least full height -->

<!-- Mobile side navigation -->
<div id="mySidenav" class="sidenav">
    <a href="javascript:void(0)" class="closebtn">&times;</a>

    <!-- Promo Code section at the top of sidenav -->
    <div class="sidenav-promo-code">
        <h5>Promo Code</h5>
        <div class="input-group">
            <input type="text" class="form-control" id="gift-code-input-sidenav" placeholder="Enter code...">
            <button class="btn btn-sm btn-deep-orange" type="button" id="submit-gift-sidenav">Apply</button>
        </div>
    </div>

    <a href="/">Home</a>
    <a href="/pack-eliquides">Shop</a>
    <a href="/cart">Cart</a>
    <a href="#" class="dropdown-toggle-mobile">Account</a>
    <div class="sidenav-dropdown">
        {% if app.user %}
            <a href="/account/details">Details</a>
            <a href="/account/orders">Orders</a>
            <a href="/logout">Logout</a>
        {% else %}
            <a href="/login" >Login</a>
            <a href="/register">Sign up</a>
        {% endif %}
    </div>
</div>

<!-- Overlay for when menu is open -->
<div class="overlay"></div>

<!-- Header Block -->
{% block header %}
    <header class="d-flex justify-content-between align-items-center p-3 bg-dark-teal position-fixed w-100 top-0 left-0 z-index-1000">

        <!-- Hamburger Menu for Mobile -->
        <span class="hamburger-menu">&#9776;</span>

        <!-- Left Section with Gift Button and Search -->
        <div class="d-flex align-items-center left-section">
            <div class="gift-input-container">
                <button class="btn btn-link p-0 me-3" id="gift-button">
                    <img src="{{ asset('uploads/gift.png') }}" alt="code eliquide vape tunisie" class="gift-icon">
                </button>
                <div class="gift-input-wrapper" style="display: none;">
                    <div class="popover-container">
                        <div class="popover-header">
                            Promo Code
                        </div>
                        <div class="popover-body">
                            <div class="input-group">
                                <input type="text" class="form-control search-bar" id="gift-code-input" placeholder="Enter Code...">
                                <button class="btn btn-deep-orange" type="button" id="submit-gift">Apply</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <form class="d-flex search-form" id="search-form">
                <div class="input-group">
                    <input id="search-input" class="form-control search-bar" type="search" placeholder="eliquid ..." aria-label="Search" name="q">
                    <button class="btn btn-deep-orange" type="submit">Search</button>
                </div>
                <div id="search-results" class="search-results"></div>
            </form>
        </div>

        <!-- Logo in Center -->
        <div class="logo mx-auto">
            <a href="/">
                <img src="{{ asset('uploads/logo.png') }}" alt="HootVaping - Boutique Vape en Tunisie" class="img-fluid" style="max-height: 100px;" >
            </a>
        </div>

        <!-- Mobile Search Toggle Button -->
        <button id="mobile-search-toggle" class="mobile-search-toggle">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#E0E0E0" class="bi bi-search" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
            </svg>
        </button>

        <!-- Add this close button inside the header tag, right after the mobile-search-toggle button -->
        <button id="mobile-search-close" class="btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#E0E0E0" class="bi bi-x-lg" viewBox="0 0 16 16">
                <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z"/>
            </svg>
        </button>

        <!-- Navigation Links (hidden on mobile) -->
        <nav class="ms-auto">
            <ul class="nav">
                <li class="nav-item"><a class="nav-link text-light-gray" href="/" style="transition: color 0.3s;" onmouseover="this.style.color='#BA3F1D'" onmouseout="this.style.color=''">Home</a></li>
                <li class="nav-item"><a class="nav-link text-light-gray" href="/pack-eliquides" style="transition: color 0.3s;" onmouseover="this.style.color='#BA3F1D'" onmouseout="this.style.color=''">Shop</a></li>
                <li class="nav-item"><a class="nav-link text-light-gray" href="/cart" style="transition: color 0.3s;" onmouseover="this.style.color='#BA3F1D'" onmouseout="this.style.color=''">Cart</a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-light-gray" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="transition: color 0.3s;" onmouseover="this.style.color='#BA3F1D'" onmouseout="this.style.color=''">
                        Account
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="accountDropdown">
                        {% if app.user %}
                            <li><a class="dropdown-item" href="/account/details">Details</a></li>
                            <li><a class="dropdown-item" href="/account/orders">Orders</a></li>
                            <li><a class="dropdown-item" href="/logout">Logout</a></li>
                        {% else %}
                            <li><a class="dropdown-item" href="/login">Login</a></li>
                            <li><a class="dropdown-item" href="/register">Sign up</a></li>
                        {% endif %}
                    </ul>
                </li>
            </ul>
        </nav>
    </header>
{% endblock %}

<!-- Main Content -->
<main class="{% block main_class %}container mt-4 flex-grow-1{% endblock %}"> <!-- Ensures main grows to fill space -->
    <!-- Loader -->
    <div id="loader">
        <div class="spinner"></div>
    </div>
    {% for label, messages in app.flashes %}
        <div class="alert alert-{{ label }}">
            {% for message in messages %}
                {{ message }}
            {% endfor %}
        </div>
    {% endfor %}

    {% block body %}{% endblock %}
</main>


<!-- Footer Block -->
{% block footer %}
    <footer class="text-center py-3 bg-dark-teal mt-auto position-relative">
        <div class="container d-flex justify-content-center">
            <!-- Centered Instagram Link -->
            <a href="https://www.instagram.com/hoot_tn" class="text-light-gray" target="_blank">
                <img src="{{ asset('uploads/instagram_logo.png') }}" alt="Instagram livraison liquide vape" style="height: 25px; filter: invert(100%);"> @hootvaping
            </a>
        </div>
        <p class="mt-3">&copy; {{ "now"|date("Y") }} HootVaping. All Rights Reserved.</p>
    </footer>
{% endblock %}
</body>
</html>

